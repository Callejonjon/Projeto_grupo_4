# Copie para .env.local e preencha. Sem estas chaves, o app roda em MODO DEMO (mock data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente servidor (rota /api/jobs/sync grava vagas ignorando RLS). NUNCA exponha no front.
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: protege a rota de sincronização (Vercel Cron envia Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
# Opcional: respostas da Mentora Virtual via Gemini. Sem ela, usa o motor de regras local.
GEMINI_API_KEY=
